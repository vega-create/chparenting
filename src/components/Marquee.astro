---
const affirmations = [
  '你今天也辛苦了 ♡',
  '不完美也沒關係',
  '你已經是最好的媽媽了',
  '記得今天也要愛自己',
  '休息不是偷懶，是充電',
  '深呼吸，你可以的',
  '你的存在就是孩子最大的禮物',
  '今天只需要做到「夠好」就好',
];

const doubled = [...affirmations, ...affirmations];
---

<!-- 低動態跑馬燈：放慢、滑鼠移上／鍵盤聚焦時暫停；系統「減少動態」時改成靜態換行顯示 -->
<div class="marquee-wrap overflow-hidden py-2.5 border-b border-warmgray-200/70" aria-label="給媽媽的鼓勵">
  <div class="marquee-track animate-marquee whitespace-nowrap inline-flex">
    {doubled.map((text, i) => (
      <span class="inline-flex items-center mx-5 text-sm tl-muted" aria-hidden={i >= affirmations.length ? 'true' : undefined}>
        <img src="/images/ui/tools/sprout.png" alt="" width="16" height="16" class="w-4 h-4 mr-1.5" loading="lazy" />
        {text}
      </span>
    ))}
  </div>
</div>

<style>
  .marquee-track { animation-duration: 60s; }
  .marquee-wrap:hover .marquee-track,
  .marquee-wrap:focus-within .marquee-track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; white-space: normal; display: flex; flex-wrap: wrap; justify-content: center; }
    .marquee-track > span[aria-hidden] { display: none; }
  }
</style>
