---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="找不到這個頁面 — 媽媽生活復原力 Lab" description="這個頁面不存在，或已經搬家了。">
  <section class="max-w-2xl mx-auto px-4 py-20 text-center">
    <p class="text-sm font-semibold tracking-[0.2em]" style="color:#e06c8a">404</p>
    <h1 class="text-3xl sm:text-4xl font-bold mt-3 mb-4">找不到這個頁面</h1>
    <p class="text-base leading-7 opacity-80 mb-8">連結可能已經過期，或文章還沒上架。可以從這裡繼續逛：</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-flex items-center rounded-full px-5 py-3 text-sm font-semibold text-white no-underline" style="background:#e06c8a">回首頁</a>
      <a href="/blog/" class="inline-flex items-center rounded-full border px-5 py-3 text-sm font-semibold no-underline" style="border-color:#e06c8a;color:#e06c8a">所有文章</a>
      <a href="/tools/" class="inline-flex items-center rounded-full border px-5 py-3 text-sm font-semibold no-underline" style="border-color:#e06c8a;color:#e06c8a">喘息工具館</a>
    </div>
  </section>
</BaseLayout>
