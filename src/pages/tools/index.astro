---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSense from '../../components/AdSense.astro';
import { tools, toolCategories, getTool } from '../../data/tools';

const featured = getTool('breathing');
const groups = toolCategories.map((cat) => ({
  ...cat,
  items: tools.filter((t) => t.category === cat.id),
}));
---

<BaseLayout title="喘息工具館" description="媽媽專屬的喘息工具：呼吸練習、壓力自我檢視、白噪音、正能量卡片、心情日記、笑話與語錄、時間與待辦整理，共 13 項，免費使用。" image="/images/og-default.jpg">
  <div class="tl-wrap pt-6 pb-4 sm:pt-10">
    <!-- 標題 + 精選 -->
    <section class="grid gap-6 lg:grid-cols-[1fr_minmax(0,420px)] lg:items-center mb-8">
      <div class="text-center lg:text-left">
        <h1 class="text-[30px] sm:text-[42px] font-bold leading-tight text-warmgray-800 mb-3">喘息工具館</h1>
        <p class="text-lg tl-muted mb-6">選一個你現在需要的工具，給自己幾分鐘的喘息時間</p>
        <a href={featured.href} class="tl-card !p-4 sm:!p-5 flex items-center gap-4 text-left hover:border-peach-400 transition-colors group">
          <img src={featured.icon} alt="" width="56" height="56" class="w-14 h-14 shrink-0 object-contain" loading="eager" />
          <span class="min-w-0 flex-1">
            <span class="block font-bold text-warmgray-800 text-lg">先從 3 分鐘呼吸開始</span>
            <span class="block text-sm tl-muted">給自己一段安靜的時間，跟著節奏，慢慢呼吸。</span>
          </span>
          <span class="tl-btn tl-btn-primary !min-h-[44px] !px-4 text-sm shrink-0 hidden sm:inline-flex">開始練習</span>
        </a>
      </div>
      <img src="/images/ui/illustration-mom.webp" alt="" width="420" height="420" class="hidden lg:block w-full max-w-[420px] mx-auto" loading="eager" />
    </section>

    <!-- 分類錨點 -->
    <nav class="sticky top-16 z-30 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 py-2 mb-6 bg-cream/95 backdrop-blur" aria-label="工具分類">
      <ul class="flex gap-2 overflow-x-auto list-none p-0 m-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {groups.map((g) => (
          <li class="shrink-0">
            <a href={`#${g.id}`} class="tl-option !min-h-[44px] !px-4 text-sm font-medium">
              <img src={g.icon} alt="" width="20" height="20" class="w-5 h-5" />
              {g.name}<span class="tl-muted font-normal">（{g.items.length}）</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {groups.map((g) => (
      <section id={g.id} class="mb-10 scroll-mt-32">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-4">
          <h2 class="tl-section-title">{g.name}</h2>
          <p class="tl-muted text-sm">{g.lead}</p>
          <p class="tl-muted text-sm ml-auto">共 {g.items.length} 個工具</p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0">
          {g.items.map((t) => (
            <li>
              <a href={t.href} class="tl-card !p-4 flex items-center gap-3.5 h-full hover:border-peach-400 transition-colors group">
                <img src={t.icon} alt="" width="48" height="48" class="w-12 h-12 shrink-0 object-contain" loading="lazy" />
                <span class="min-w-0 flex-1">
                  <span class="block font-bold text-warmgray-800 group-hover:text-peach-600 transition-colors">{t.name}</span>
                  <span class="block text-sm tl-muted">{t.short}</span>
                </span>
                <span class="text-peach-600 shrink-0" aria-hidden="true">›</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="mt-4">
      <p class="text-xs text-center tl-muted mb-1">廣告</p>
      <AdSense slot="bottom" />
    </div>
  </div>
</BaseLayout>
