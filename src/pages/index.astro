---
import BaseLayout from '../layouts/BaseLayout.astro';
import MoodCheck from '../components/tools/MoodCheck';
import PostCard from '../components/PostCard.astro';
import { siteConfig } from '../site.config';
import { getCollection } from 'astro:content';
import { getTool, homeToolIds, homeToolLabels } from '../data/tools';

// Get published posts (filter future dates for scheduled publishing)
const now = new Date();
const allPosts = await getCollection('posts', ({ data }) => {
  return !data.draft && new Date(data.publishDate) <= now;
});
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 6);

const homeTools = homeToolIds.map((id) => ({ ...getTool(id), label: homeToolLabels[id] }));

// 孩子的免費學習平台（薇佳媽媽自己開發的免費子站）
// 刻意放在首頁上半部：learn 子網域被 Google 停止檢索，需要主站首頁這種
// 每天被爬的頁面給它明確的入口與描述性錨文字。
const learnLinks = [
  { name: 'GEPT 英檢練習', desc: '初級・中級・中高級題庫', href: 'https://learn.chparenting.com/elementary', icon: '/images/ui/learn/book.png' },
  { name: 'JLPT 日文練習', desc: '五十音到 N1', href: 'https://learn.chparenting.com/jlpt-n5', icon: '/images/ui/learn/torii.png' },
  { name: '國小數學練習', desc: '觀念講解＋逐步解題', href: 'https://learn.chparenting.com/math', icon: '/images/ui/learn/ruler.png' },
  { name: '教育桌遊', desc: '18 款邏輯・記憶・程式遊戲', href: 'https://learn.chparenting.com/board-games', icon: '/images/ui/learn/puzzle.png' },
];

const categoryIcons: Record<string, string> = {
  'parenting-crisis': '/images/ui/cat/bear.png',
  'mom-emotions': '/images/ui/cat/heart.png',
  'parent-child': '/images/ui/cat/family.png',
  'kids-learning': '/images/ui/cat/cap.png',
  'practical-life': '/images/ui/cat/leaf.png',
};
---

<BaseLayout>
  <!-- 鼓勵短句列（靜態） -->
  <p class="text-center text-sm tl-muted py-2.5 border-b border-warmgray-200/70 px-4">
    <img src="/images/ui/tools/sprout.png" alt="" width="18" height="18" class="inline-block w-[18px] h-[18px] align-[-4px] mr-1" />
    慢一點沒關係，你已經做得很好了。
  </p>

  <div class="tl-wrap pt-8 sm:pt-12">

    <!-- Hero -->
    <section class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_420px] lg:items-center mb-8 sm:mb-10">
      <div class="text-center lg:text-left">
        <h1 class="text-[32px] sm:text-[44px] font-bold leading-tight text-warmgray-800 mb-2">媽媽不需要完美</h1>
        <p class="text-xl sm:text-2xl font-medium text-warmgray-700 mb-3">只需要一個能喘口氣的空間</p>
        <p class="tl-muted max-w-md mx-auto lg:mx-0">在這裡，你可以放下忙碌、緩一口氣，找回屬於自己的節奏。</p>
      </div>
      <img src="/images/ui/hero-cup.webp" alt="" width="420" height="315" class="w-full max-w-[320px] lg:max-w-[420px] mx-auto" loading="eager" fetchpriority="high" />
    </section>

    <!-- 心情卡 + 立即喘息推薦 -->
    <section class="mb-12 sm:mb-16">
      <MoodCheck client:load />
    </section>

    <!-- 喘息工具箱 -->
    <section class="mb-12 sm:mb-16">
      <div class="flex items-end justify-between gap-4 mb-5">
        <div>
          <h2 class="tl-section-title">喘息工具箱</h2>
          <p class="text-sm tl-muted">小小的練習，給忙碌的你一點喘息的空間。</p>
        </div>
        <a href="/tools/" class="text-sm font-bold text-peach-700 hover:underline shrink-0 min-h-[44px] inline-flex items-center">全部工具 →</a>
      </div>
      <ul class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 list-none p-0 m-0">
        {homeTools.map((t) => (
          <li>
            <a href={t.href} class="tl-card !p-4 sm:!p-5 flex flex-col gap-3 h-full hover:border-peach-400 transition-colors group">
              <img src={t.icon} alt="" width="48" height="48" class="w-12 h-12 object-contain" loading="lazy" />
              <span>
                <span class="block font-bold text-warmgray-800 group-hover:text-peach-600 transition-colors">{t.label}</span>
                <span class="block text-sm tl-muted">{t.short}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 孩子的免費學習平台 -->
    <section class="mb-12 sm:mb-16">
      <div class="flex items-end justify-between gap-4 mb-3">
        <div>
          <h2 class="tl-section-title">孩子的免費學習平台</h2>
          <p class="text-sm tl-muted">精選優質學習資源，陪伴孩子快樂成長。</p>
        </div>
        <a href="https://learn.chparenting.com/" class="text-sm font-bold text-peach-700 hover:underline shrink-0 min-h-[44px] inline-flex items-center">全部科目 →</a>
      </div>
      <p class="tl-muted text-sm mb-5 max-w-2xl">
        我為自己的孩子準備英檢時做的練習平台，完全免費、不用註冊、練習單可以直接列印。
        英檢、日檢、數學、國語、樂理、社會科都有，每一題都附解說。
      </p>
      <ul class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 list-none p-0 m-0">
        {learnLinks.map((l) => (
          <li>
            <a href={l.href} class="tl-card !p-4 flex items-center gap-3 h-full hover:border-peach-400 transition-colors group">
              <img src={l.icon} alt="" width="44" height="44" class="w-11 h-11 shrink-0 object-contain" loading="lazy" />
              <span class="min-w-0">
                <span class="block font-bold text-warmgray-800 text-[15px] group-hover:text-peach-600 transition-colors">{l.name}</span>
                <span class="block text-xs tl-muted">{l.desc}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 探索分類 -->
    <section class="mb-12 sm:mb-16">
      <h2 class="tl-section-title mb-1">探索分類</h2>
      <p class="text-sm tl-muted mb-5">從生活中找到共鳴，發現更多適合你的內容。</p>
      <ul class="flex flex-wrap gap-2.5 list-none p-0 m-0">
        {siteConfig.categories.map((cat) => (
          <li>
            <a href={`/category/${cat.slug}/`} class="tl-option !min-h-[48px] !px-4 font-bold text-[15px] hover:text-peach-600">
              <img src={categoryIcons[cat.slug]} alt="" width="24" height="24" class="w-6 h-6" loading="lazy" />
              {cat.name}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 最新文章 -->
    {latestPosts.length > 0 && (
      <section class="mb-12 sm:mb-16">
        <div class="flex items-end justify-between gap-4 mb-5">
          <div>
            <h2 class="tl-section-title">最新文章</h2>
            <p class="text-sm tl-muted">從真實的經驗出發，陪你一起找到更輕鬆的生活節奏。</p>
          </div>
          <a href="/blog/" class="text-sm font-bold text-peach-700 hover:underline shrink-0 min-h-[44px] inline-flex items-center">更多文章 →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
          {latestPosts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              category={post.data.category}
              publishDate={post.data.publishDate}
              image={post.data.image}
            />
          ))}
        </div>
      </section>
    )}

    <!-- 支持訊息 -->
    <section class="mb-16">
      <div class="tl-card flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left">
        <img src="/images/ui/illustration-mom.webp" alt="" width="160" height="160" class="w-32 h-32 sm:w-40 sm:h-40 shrink-0" loading="lazy" />
        <div class="flex-1">
          <h2 class="tl-section-title mb-2">你不是一個人</h2>
          <p class="tl-muted mb-5">我們都在這裡，陪你一起走。這裡是你的喘息空間，隨時回來休息。</p>
          <a href="/tools/" class="tl-btn tl-btn-primary">給自己一點時間吧 →</a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
