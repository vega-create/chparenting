---
import BaseLayout from './BaseLayout.astro';
import FAQSchema from '../components/FAQSchema.astro';
import ArticleSchema from '../components/ArticleSchema.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import AuthorBox from '../components/AuthorBox.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import AdSense from '../components/AdSense.astro';
import { siteConfig } from '../site.config';
import ShareButtons from '../components/ShareButtons.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    publishDate: string;
    category: string;
    tags: string[];
    image?: string;
    imageAlt?: string;
    faq?: { q: string; a: string }[];
  };
  headings: { depth: number; slug: string; text: string }[];
  readingMinutes?: number;
}

const { frontmatter, headings, readingMinutes } = Astro.props;
const { title, description, publishDate, category, tags, image, imageAlt, faq } = frontmatter;

const categoryInfo = siteConfig.categories.find(c => c.slug === category || c.name === category);
const categorySlug = categoryInfo?.slug || category;
const dateStr = new Date(publishDate).toLocaleDateString('zh-TW', {
  year: 'numeric', month: 'long', day: 'numeric'
});

// 與 learn 文章頁同一張作者照片
const AUTHOR_PHOTO = 'https://character.chparenting.com/src/img/author.jpg';
const tocAll = headings.filter(h => h.depth === 2 || h.depth === 3);
const tocH2 = headings.filter(h => h.depth === 2);
if (faq && faq.length > 0) {
  tocAll.push({ depth: 2, slug: '常見問題', text: '常見問題' });
  tocH2.push({ depth: 2, slug: '常見問題', text: '常見問題' });
}
---

<BaseLayout title={title} description={description} image={image} type="article" publishDate={new Date(publishDate)}>
  <!-- Structured Data -->
  <ArticleSchema
    title={title}
    description={description}
    publishDate={publishDate}
    image={image}
    url={siteConfig.url + Astro.url.pathname}
    category={categoryInfo?.name}
    tags={tags}
  />
  <BreadcrumbSchema items={[
    { name: '首頁', url: '/' },
    ...(categoryInfo ? [{ name: categoryInfo.name, url: `/category/${categorySlug}/` }] : []),
    { name: title },
  ]} />

  <div class="max-w-6xl mx-auto px-4 pt-4 pb-14 md:pt-6">
    <!-- Breadcrumb -->
    <nav class="google-anno-skip text-sm text-warmgray-500 mb-5" aria-label="breadcrumb">
      <ol class="flex items-center list-none p-0 m-0 min-w-0">
        <li class="shrink-0"><a href="/" class="hover:text-peach-600 transition-colors">首頁</a></li>
        <li class="shrink-0" aria-hidden="true"><span class="mx-2 text-warmgray-300">›</span></li>
        {categoryInfo && (
          <>
            <li class="shrink-0"><a href={`/category/${categorySlug}/`} class="text-peach-600 font-semibold hover:text-peach-700 transition-colors">{categoryInfo.name}</a></li>
            <li class="shrink-0" aria-hidden="true"><span class="mx-2 text-warmgray-300">›</span></li>
          </>
        )}
        <li class="truncate min-w-0 text-warmgray-400" aria-current="page">{title}</li>
      </ol>
    </nav>

    <div class="lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-8 lg:items-start">
      <!-- 左側目錄（桌機） -->
      {tocH2.length > 0 && (
        <aside class="google-anno-skip hidden lg:block sticky top-24">
          <nav class="bg-white border border-warmgray-200 rounded-2xl p-4" aria-label="本文重點">
            <div class="text-[15px] font-bold text-warmgray-800 px-3 pb-2 mb-1 border-b border-warmgray-100">本文重點</div>
            <ol class="list-none p-0 m-0 space-y-0.5">
              {tocH2.map((h) => (
                <li><a href={`#${h.slug}`} class="block rounded-lg px-3 py-1.5 text-sm leading-snug text-warmgray-600 hover:bg-peach-50 hover:text-peach-700 transition-colors">{h.text}</a></li>
              ))}
            </ol>
          </nav>
        </aside>
      )}

      <div class={`min-w-0 ${tocH2.length === 0 ? 'lg:col-span-2' : ''}`}>
        <article class="bg-white md:border md:border-warmgray-200 md:rounded-2xl md:px-10 md:py-9">
          <div class="max-w-[720px] mx-auto">
            <!-- Header -->
            <header class="google-anno-skip mb-7">
              {categoryInfo && (
                <a href={`/category/${categorySlug}/`} class="inline-block text-xs font-bold px-3 py-1 rounded-full bg-peach-100 text-peach-700 mb-3">
                  {categoryInfo.emoji} {categoryInfo.name}
                </a>
              )}
              <h1 class="text-[26px] md:text-[34px] font-black text-warmgray-800 leading-[1.3] m-0 mb-4">{title}</h1>
              <div class="flex items-center gap-x-4 gap-y-2 flex-wrap text-sm text-warmgray-500">
                <a href="/about/" rel="author" class="inline-flex items-center gap-2 text-warmgray-800 font-bold hover:text-peach-600 transition-colors">
                  <img src={AUTHOR_PHOTO} alt="" width="32" height="32" class="w-8 h-8 rounded-full object-cover border border-warmgray-200 bg-warmgray-100" />
                  {siteConfig.author}（Vega）
                </a>
                <span>發布 <time datetime={publishDate}>{dateStr}</time></span>
                {readingMinutes && <span>閱讀約 {readingMinutes} 分鐘</span>}
              </div>
            </header>

            <!-- Cover Image -->
            {image && (
              <img
                src={image}
                alt={imageAlt || title}
                class="w-full aspect-[1200/630] object-cover rounded-2xl border border-warmgray-200 mb-7"
                width="1200"
                height="630"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            )}

            <!-- 文章重點：用文章自己的摘要 -->
            {description && (
              <div class="google-anno-skip bg-peach-50 border border-peach-200 rounded-2xl px-5 py-4 md:px-6 md:py-5 mb-8">
                <div class="text-[15px] font-bold text-peach-700 mb-1.5">文章重點</div>
                <p class="text-[16px] leading-[1.85] text-warmgray-700 m-0">{description}</p>
              </div>
            )}

            <!-- 手機／平板目錄：預設收合 -->
            {tocAll.length >= 3 && (
              <details class="google-anno-skip lg:hidden bg-warmgray-100/60 border border-warmgray-200 rounded-2xl mb-8 group">
                <summary class="cursor-pointer list-none flex items-center justify-between px-5 py-3.5 font-bold text-warmgray-800">
                  本文目錄
                  <span class="text-warmgray-500 text-sm font-normal group-open:hidden">展開 ▾</span>
                  <span class="text-warmgray-500 text-sm font-normal hidden group-open:inline">收合 ▴</span>
                </summary>
                <ol class="list-none m-0 px-2 pb-3 space-y-0.5">
                  {tocAll.map((h) => (
                    <li class={h.depth === 3 ? 'pl-4' : ''}><a href={`#${h.slug}`} class={`block rounded-lg px-3 py-1.5 leading-snug hover:bg-peach-50 hover:text-peach-700 ${h.depth === 3 ? 'text-[13px] text-warmgray-500' : 'text-[15px] text-warmgray-600'}`}>{h.text}</a></li>
                  ))}
                </ol>
              </details>
            )}

            <!-- Ad: Top -->
            <AdSense slot="top" format="horizontal" />

            <!-- Article Content -->
            <div class="prose-warm post-prose">
              <slot />
            </div>

            <!-- Ad: Mid Article -->
            <AdSense slot="mid" />

            <!-- FAQ Section -->
            {faq && faq.length > 0 && (
              <section class="mt-12">
                <h2 id="常見問題" class="text-xl md:text-[22px] font-bold text-warmgray-800 border-l-4 border-peach-400 pl-3 mb-4 scroll-mt-24">常見問題</h2>
                <dl class="m-0 bg-warmgray-100/60 border border-warmgray-200 rounded-2xl divide-y divide-warmgray-200">
                  {faq.map((item) => (
                    <div class="p-5">
                      <dt class="font-bold text-warmgray-800 mb-1.5">Q：{item.q}</dt>
                      <dd class="text-warmgray-600 leading-[1.85] m-0">{item.a}</dd>
                    </div>
                  ))}
                </dl>
                <FAQSchema faqs={faq} />
              </section>
            )}

            <!-- Tags -->
            {tags && tags.length > 0 && (
              <div class="google-anno-skip mt-10 pt-6 border-t border-warmgray-100 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <span class="text-xs text-warmgray-500 bg-warmgray-100 px-2.5 py-1 rounded-full">#{tag}</span>
                ))}
              </div>
            )}

            <!-- 社群分享 -->
            <ShareButtons title={title} />
          </div>
        </article>

        <!-- Ad: Bottom -->
        <AdSense slot="bottom" />

        <!-- 作者介紹 -->
        <AuthorBox />

        <!-- 相關文章 -->
        <RelatedPosts category={category} currentSlug={Astro.url.pathname} />

        <div class="mt-4">
          <a href="/blog/" class="text-sm font-semibold text-peach-600 hover:underline">← 回到所有文章</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>